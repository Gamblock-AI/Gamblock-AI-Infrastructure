---
# Scheduled backup configuration rendered by Ansible and sourced by backup.sh.
# Non-secret values only; no credentials ever appear here.
BACKUP_ROOT={{ backup_root }}
POSTGRES_CONTAINER={{ postgres_container_name }}
POSTGRES_BACKUPS_HOST_DIR={{ docker_stack_base }}/postgres/backups
DB_USER={{ gamblock_db_username }}
DB_NAMES={{ backup_db_names | join(' ') }}
BACKEND_CONTAINERS={{ backup_backend_containers | join(' ') }}
RETENTION_DAYS={{ backup_retention_days }}
