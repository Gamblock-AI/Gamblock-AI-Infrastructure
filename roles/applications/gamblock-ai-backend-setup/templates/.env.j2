APP_ENV={{ gamblock_backend_app_env }}
HTTP_ADDR=:{{ gamblock_ai_backend.port }}
PUBLIC_WEB_BASE_URL=https://{{ primary_domain }}
NOTIFICATION_MODE={{ gamblock_backend_notification_mode }}
ENABLE_DEV_LOGIN={{ gamblock_backend_enable_dev_login | bool | lower }}
ENABLE_DEMO_DATA={{ gamblock_backend_enable_demo_data | bool | lower }}

DATABASE_URL=postgres://{{ gamblock_db_username }}:{{ vault_postgres_password }}@{{ postgres_container_name }}:{{ postgres_port }}/{{ gamblock_db_name }}?sslmode=disable

JWT_ACCESS_SECRET={{ vault_gamblock_backend.jwt_access_secret }}
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h

PROTECTION_GRANT_SIGNING_PRIVATE_KEY={{ vault_gamblock_backend.protection_grant_signing_private_key }}
PROTECTION_GRANT_SIGNING_KEY_ID={{ protection_grant_signing_key_id }}

CORS_ALLOWED_ORIGINS={{ gamblock_backend_cors_origins | join(',') }}

ARTIFACT_STORAGE_PATH=/app/var/artifacts
EXPORT_STORAGE_PATH=/app/var/exports
MEDIA_STORAGE_PATH=/app/var/media/education
AVATAR_STORAGE_PATH=/app/var/media/avatars
MEDIA_EMBED_ALLOWED_HOSTS={{ media_embed_allowed_hosts | join(',') }}

JOURNAL_ENCRYPTION_KEY={{ vault_gamblock_backend.journal_encryption_key }}

FONNTE_TOKEN={{ vault_gamblock_backend.fonnte_token }}
FONNTE_BASE_URL={{ vault_gamblock_backend.fonnte_base_url }}
FONNTE_COUNTRY_CODE={{ vault_gamblock_backend.fonnte_country_code }}

DEEPSEEK_API_KEY={{ vault_gamblock_backend.deepseek_api_key }}
DEEPSEEK_BASE_URL={{ deepseek_base_url }}
DEEPSEEK_MODEL={{ deepseek_model }}
SPK_LLM_ENRICHMENT={{ spk_llm_enrichment | bool | lower }}

VAPID_PUBLIC_KEY={{ vapid_public_key }}
VAPID_PRIVATE_KEY={{ vault_vapid_private_key }}
VAPID_SUBJECT={{ vapid_subject }}

{# One-shot guard constants for the guarded tools services. Non-secret; the #}
{# demo seeder and the destructive tools refuse to run without their exact #}
{# confirmation value. #}
CONFIRM_DEMO_SEED={{ demo_seed_confirm | default('') }}
CONFIRM_MIGRATE_DOWN={{ migrate_down_confirm | default('') }}
CONFIRM_RESET_STORAGE={{ reset_storage_confirm | default('') }}
